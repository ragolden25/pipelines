{
  "id": 31,
  "type": "stat",
  "title": "GRAFANA STACK · Molecule tests (weekly)",
  "description": "Result of the last weekly Molecule run (play_weekly_molecule.sh, Thursday 0400, after the weekly builds) for the Grafana stack. Deployment role = the configure_grafana_stack role on a Debian container; nucleus images / ccop images = the actual weekly images started on the role-staged config. Green OK = tests ran and passed. Red FAILED = the latest weekly image or the role config broke (see /opt/ansible/molecule/logs/). Amber NOT REPORTED = not tested this week (no fresh image) or the scenario has not run yet.",
  "gridPos": {
    "x": 0,
    "y": 26,
    "h": 6,
    "w": 12
  },
  "fieldConfig": {
    "defaults": {
      "mappings": [
        {
          "options": {
            "0": {
              "color": "#d03b3b",
              "index": 1,
              "text": "FAILED"
            },
            "1": {
              "color": "#0ca30c",
              "index": 0,
              "text": "OK"
            },
            "2": {
              "color": "#fab219",
              "index": 2,
              "text": "NOT REPORTED"
            },
            "-1": {
              "color": "#fab219",
              "index": 3,
              "text": "NOT REPORTED"
            }
          },
          "type": "value"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "#d03b3b",
            "value": null
          },
          {
            "color": "#0ca30c",
            "value": 1
          }
        ]
      },
      "color": {
        "mode": "thresholds"
      },
      "noValue": "no data yet"
    },
    "overrides": [
      {
        "matcher": { "id": "byName", "options": "role-config" },
        "properties": [ { "id": "displayName", "value": "Deployment role" } ]
      },
      {
        "matcher": { "id": "byName", "options": "image-nucleus" },
        "properties": [ { "id": "displayName", "value": "nucleus images" } ]
      },
      {
        "matcher": { "id": "byName", "options": "image-ccop" },
        "properties": [ { "id": "displayName", "value": "ccop images" } ]
      }
    ]
  },
  "pluginVersion": "12.4.11",
  "targets": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ds-prometheus"
      },
      "expr": "pipeline_weekly_molecule_status{stack=\"grafana\"} or on(test) label_replace(vector(-1), \"test\", \"role-config\", \"\", \"\") or on(test) label_replace(vector(-1), \"test\", \"image-nucleus\", \"\", \"\") or on(test) label_replace(vector(-1), \"test\", \"image-ccop\", \"\", \"\")",
      "instant": true,
      "legendFormat": "{{test}}",
      "range": false,
      "refId": "A",
      "editorMode": "code"
    }
  ],
  "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
  },
  "options": {
    "reduceOptions": {
      "values": false,
      "calcs": [
        "lastNotNull"
      ],
      "fields": ""
    },
    "orientation": "horizontal",
    "textMode": "value_and_name",
    "wideLayout": true,
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "showPercentChange": false,
    "percentChangeColorMode": "standard",
    "text": {
      "titleSize": 18,
      "valueSize": 24
    }
  }
}
